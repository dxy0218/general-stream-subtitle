#!name=General Stream Subtitle
#!desc=Apple TV 播放优先的 HLS 中文字幕安全适配（v0.6.11）
#!author=dxy0218 & contributors
#!homepage=https://github.com/dxy0218/general-stream-subtitle
#!arguments=DISCOVERY:false, DISCOVERY_HLS_ONLY:true, MAX:true, PLUTO:true, PRIME:true, HULU:true, YOUTUBE:true, YT_ASR:true, YT_LIVE:true, HY_MT2:false, PURE_TRACK:false, CACHE:true, LOGS:true, DEBUG:false
#!arguments-desc=DISCOVERY: Discovery+ 实验适配；默认关闭，打开后仅处理 HLS 主清单\n\nDISCOVERY_HLS_ONLY: Discovery+ 播放保护；保持开启以跳过 DASH 和播放 JSON\n\nMAX: Max / HBO Max HLS 中文字幕\n\nPLUTO: Pluto TV HLS 中文字幕\n\nPRIME: Amazon Prime Video HLS 中文字幕\n\nHULU: Hulu HLS 中文字幕\n\nYOUTUBE: YouTube / YouTube TV 中文字幕\n\nYT_ASR: 允许 YouTube 自动生成字幕\n\nYT_LIVE: 处理 YouTube 直播文本字幕\n\nHY_MT2: 使用私有 Hy-MT2 翻译服务；先在管理页保存 Endpoint 和 API Key\n\nPURE_TRACK: 额外显示纯翻译字幕轨\n\nCACHE: 启用翻译缓存\n\nLOGS: 保存脱敏运行日志，便于排查播放和字幕错误\n\nDEBUG: 输出调试日志

[Script]
GSS Max Discovery Media = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*(?:prod\.media\.max\.com|prd\.media\.max\.com|prod\.media\.h264\.io|prd\.media\.h264\.io|hbomaxcdn\.com)|manifests(?:\.v2)?\.api\.hbo\.com|[^\/.]*discovery[^\/.]*\.uplynk\.com|(?:dplus|discovery)[^\/.]*\.(?:h264\.io|akamaized\.net))\/.*\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Pluto Master = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*prd\.pluto\.tv|stitcher-ipv4\.pluto\.tv|service-stitcher\.clusters\.pluto\.tv|stitcher\.pluto\.tv)\/.*\/master(?:\/[^?]*\.m3u8|\.m3u8)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Prime Video HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*hls\.(?:pv-cdn|row\.aiv-cdn)\.net|avodhlss3ww-a\.akamaihd\.net|(?:d1v5ir2lpwr8os|d22qjgkvxw22r6|d25xi40x97liuc|d27xxe7juh1us6|dmqdd6hw24ucf)\.cloudfront\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Hulu HLS = type=http-response, pattern=^https?:\/\/(?:vodmanifest|manifest-dp|livemanifest-f|live-sc)\.hulustream\.com\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Gateway = type=http-request, pattern=^https?:\/\/(?:example\.com|gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/(?!save(?:[\/?#]|$)).*, requires-body=0, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/gateway.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Gateway Save = type=http-request, pattern=^https?:\/\/(?:example\.com|gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/save(?:\?.*)?$, requires-body=1, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/gateway.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS YouTube Player = type=http-response, pattern=^https?:\/\/(?:www\.youtube\.com|m\.youtube\.com|music\.youtube\.com|tv\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=30, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/youtube.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS YouTube Caption = type=http-response, pattern=^https?:\/\/(?:www\.youtube\.com|m\.youtube\.com|music\.youtube\.com|tv\.youtube\.com)\/api\/timedtext\?.*(?:gss_mode|gss_v)=.*, requires-body=1, max-size=4194304, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/youtube-caption.js?v=0.6.11, argument=presetMode=true&safePlayback=true&maxReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformYoutube={{{YOUTUBE}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}

[MITM]
hostname = %APPEND% *.prod.media.max.com, *.prd.media.max.com, *.prod.media.h264.io, *.prd.media.h264.io, *.hbomaxcdn.com, manifests.api.hbo.com, manifests.v2.api.hbo.com, *discovery*.uplynk.com, dplus-*.akamaized.net, dplus-*.h264.io, discovery-*.h264.io, stitcher-ipv4.pluto.tv, service-stitcher.clusters.pluto.tv, stitcher.pluto.tv, *.prd.pluto.tv, *.hls.pv-cdn.net, *.hls.row.aiv-cdn.net, *avodhlss3ww-a.akamaihd.net, d1v5ir2lpwr8os.cloudfront.net, d22qjgkvxw22r6.cloudfront.net, d25xi40x97liuc.cloudfront.net, d27xxe7juh1us6.cloudfront.net, dmqdd6hw24ucf.cloudfront.net, vodmanifest.hulustream.com, manifest-dp.hulustream.com, livemanifest-f.hulustream.com, live-sc.hulustream.com, *.youtube.com, youtubei.googleapis.com, example.com, gss.local
