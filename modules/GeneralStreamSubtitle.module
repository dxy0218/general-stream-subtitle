#!name=General Stream Subtitle
#!desc=多平台 HLS/DASH、多字幕格式、多翻译引擎（v0.5.7）
#!author=dxy0218 & contributors
#!homepage=https://github.com/dxy0218/general-stream-subtitle
#!arguments=SOURCE:auto, TARGET:zh-CN, TRACK_NAME:Translate-zh, PROVIDER:google-free, PLATFORMS:all, DISCOVERY_MODE:full, FORMATS:all, GENERIC:false, YT_STRATEGY:direct, YT_ASR:true, YT_LIVE:true, YT_MANUAL:true, PURE_TRACK:false, ORDER:translation-first, CACHE:true, DEBUG:false
#!arguments-desc=SOURCE: [auto, en, ja, ko, es, fr, de, it, pt, ru, ar, hi, th, vi, id, zh-CN, zh-TW]\n源字幕语言；auto 自动识别\n\nTARGET: [zh-CN, zh-TW, en, ja, ko, es, fr, de, it, pt, ru, ar, hi, th, vi, id]\n翻译目标语言\n\nTRACK_NAME: [Translate-zh, 中文双语, 双语字幕, 中文字幕]\n字幕菜单中显示的翻译轨名称\n\nPROVIDER: [google-free, google-cloud, deepl, azure, libretranslate, openai, openai-compatible, gemini, custom-json]\n翻译引擎；API Key 在 gss.local 保存\n\nPLATFORMS: [all, discovery, max, disney, prime, apple-tv-plus, apple-fitness, apple-tv, youtube|youtube-tv, paramount|paramount-live, peacock, hulu, fubo, ted, bbc, viki, tubi, pluto, crunchyroll, dazn, plex]\n启用平台；组合预设使用竖线分隔\n\nDISCOVERY_MODE: [full, hls-only, off]\nDiscovery+ 处理范围；始终覆盖 gss.local 旧设置\n\nFORMATS: [all, youtube, vtt, srt, ttml, ass, json]\n启用字幕格式\n\nGENERIC: [false, true]\n通用 HLS/DASH 检查\n\nYT_STRATEGY: [direct, virtual]\nYouTube 字幕接管方式\n\nYT_ASR: [true, false]\n允许 YouTube 自动生成字幕\n\nYT_LIVE: [true, false]\n处理 YouTube 直播字幕\n\nYT_MANUAL: [true, false]\n优先选择 YouTube 人工字幕\n\nPURE_TRACK: [false, true]\n额外显示纯翻译字幕轨\n\nORDER: [translation-first, original-first]\n双语字幕显示顺序\n\nCACHE: [true, false]\n启用翻译缓存\n\nDEBUG: [false, true]\n输出调试日志

[Script]
GSS Manifest = type=http-response, pattern=^https?:\/\/(?!(?:[^\/]+\.)*(?:pluto\.tv|pplus\.paramount\.tech|paramount\.tech|paramountplus\.com|cbsaavideo\.com|cbsivideo\.com|cbs\.com|max\.com|discomax\.com|h264\.io|hbomaxcdn\.com|api\.hbo\.com|uplynk\.com)(?::\d+)?\/).+\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS Pluto Master = type=http-response, pattern=^https?:\/\/(?:stitcher-ipv4\.pluto\.tv|service-stitcher\.clusters\.pluto\.tv|stitcher\.pluto\.tv)\/.*\/master(?:\/[^?]*\.m3u8|\.m3u8)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS Paramount Live Manifest = type=http-response, pattern=^https?:\/\/(?:[^\/]+\.)*(?:pplus\.paramount\.tech|paramount\.tech|paramountplus\.com|cbsaavideo\.com|cbsivideo\.com|cbs\.com)\/.*(?:master|manifest)[^?]*\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS Paramount Playback = type=http-response, pattern=^https?:\/\/(?:[^\/]+\.)*(?:pplus\.paramount\.tech|paramount\.tech|paramountplus\.com|cbsaavideo\.com|cbsivideo\.com|cbs\.com)\/.*(?:playback|stream|live|linear|channel|station|session|manifest).*, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS Max Discovery Playback = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*(?:max\.com|discomax\.com|h264\.io|hbomaxcdn\.com|api\.hbo\.com)|[^\/.]*discovery[^\/.]*\.uplynk\.com)\/.*, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/manifest.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS Gateway = type=http-request, pattern=^https?:\/\/(?:gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/.*, requires-body=1, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/gateway.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS YouTube Player = type=http-response, pattern=^https?:\/\/(?:www\.youtube\.com|m\.youtube\.com|music\.youtube\.com|tv\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=30, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/youtube.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}
GSS YouTube Caption = type=http-response, pattern=^https?:\/\/(?:www\.youtube\.com|m\.youtube\.com|music\.youtube\.com|tv\.youtube\.com)\/api\/timedtext\?.*(?:gss_mode|gss_v)=.*, requires-body=1, max-size=4194304, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/youtube-caption.js, argument=source={{{SOURCE}}}&target={{{TARGET}}}&trackName={{{TRACK_NAME}}}&provider={{{PROVIDER}}}&platforms={{{PLATFORMS}}}&discoveryMode={{{DISCOVERY_MODE}}}&formats={{{FORMATS}}}&genericMode={{{GENERIC}}}&youtubeStrategy={{{YT_STRATEGY}}}&youtubeUseAsr={{{YT_ASR}}}&youtubeLive={{{YT_LIVE}}}&youtubePreferManual={{{YT_MANUAL}}}&injectTranslated={{{PURE_TRACK}}}&bilingualOrder={{{ORDER}}}&cacheEnabled={{{CACHE}}}&debug={{{DEBUG}}}

[MITM]
hostname = %APPEND% *.max.com, *.discomax.com, *.h264.io, *.hbomaxcdn.com, *.api.hbo.com, *.media.dssott.com, *.prod.dssott.com, *.media.starott.com, *.prod.starott.com, *.media.dssedge.com, *.prod.dssedge.com, *.hls.pv-cdn.net, *.hls.row.aiv-cdn.net, *avodhlss3ww-a.akamaihd.net, s3.amazonaws.com, cf-timedtext.aux.pv-cdn.net, d1v5ir2lpwr8os.cloudfront.net, d22qjgkvxw22r6.cloudfront.net, d25xi40x97liuc.cloudfront.net, d27xxe7juh1us6.cloudfront.net, dmqdd6hw24ucf.cloudfront.net, vodmanifest.hulustream.com, manifest-dp.hulustream.com, *.pplus.paramount.tech, *.paramount.tech, *.paramountplus.com, *.cbsaavideo.com, *.cbsivideo.com, *.cbs.com, *.cdn.peacocktv.com, *discovery*.uplynk.com, dplus-*.akamaized.net, *.fubo.tv, hls.ted.com, *.bbci.co.uk, vod-*-live.akamaized.net, *.viki.io, *.viki.com, *.tubi.video, *.tubitv.com, stitcher-ipv4.pluto.tv, service-stitcher.clusters.pluto.tv, stitcher.pluto.tv, *.crunchyroll.com, *.vrv.co, *.dazn.com, *.dazn-api.com, *.plex.tv, *.youtube.com, youtubei.googleapis.com, gss.local
