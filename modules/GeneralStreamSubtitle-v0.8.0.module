#!name=General Stream Subtitle v0.8.0
#!desc=Apple TV 播放优先的 HLS 中文字幕安全适配（v0.8.0）
#!author=dxy0218 & contributors
#!homepage=https://github.com/dxy0218/general-stream-subtitle
#!arguments=DISCOVERY:false, DISCOVERY_HLS_ONLY:true, MAX:true, PLUTO:true, PRIME:true, HULU:true, PARAMOUNT:true, OTHER:true, HY_MT2:false, PURE_TRACK:false, CACHE:true, LOGS:true, DEBUG:false
#!arguments-desc=DISCOVERY: Discovery+ 实验适配；默认关闭，打开后仅处理 HLS 主清单\n\nDISCOVERY_HLS_ONLY: Discovery+ 播放保护；保持开启以跳过 DASH 和播放 JSON\n\nMAX: Max / HBO Max HLS 中文字幕\n\nPLUTO: Pluto TV HLS 中文字幕\n\nPRIME: Amazon Prime Video HLS 中文字幕\n\nHULU: Hulu HLS 中文字幕\n\nPARAMOUNT: Paramount+ HLS 中文字幕\n\nOTHER: 其他 HLS 平台：Disney+、Peacock、Fubo、TED、BBC、Viki、Tubi、Crunchyroll、DAZN、Plex\n\nHY_MT2: 使用私有 Hy-MT2 翻译服务；先在管理页保存 Endpoint 和 API Key\n\nPURE_TRACK: 额外显示纯翻译字幕轨\n\nCACHE: 启用翻译缓存\n\nLOGS: 保存脱敏运行日志，便于排查播放和字幕错误\n\nDEBUG: 输出调试日志

[Script]
GSS Other Media Manifest = type=http-response, pattern=^https?:\/\/(?!(?:[^\/]+\.)*(?:pluto\.tv|plutotv\.net|pplus\.paramount\.tech|paramount\.tech|paramountplus\.com|cbsaavideo\.com|cbsivideo\.com|cbs\.com|max\.com|discomax\.com|h264\.io|hbomaxcdn\.com|api\.hbo\.com|uplynk\.com|pv-cdn\.net|aiv-cdn\.net|hulustream\.com|huluim\.com)(?::\d+)?\/).+\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Max Discovery Media = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*(?:prod\.media\.max\.com|prd\.media\.max\.com|prod\.media\.h264\.io|prd\.media\.h264\.io|hbomaxcdn\.com)|manifests(?:\.v2)?\.api\.hbo\.com|[^\/.]*discovery[^\/.]*\.uplynk\.com|(?:dplus|discovery)[^\/.]*\.(?:h264\.io|akamaized\.net))\/.*\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Pluto HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*prd\.pluto\.tv|stitcher-ipv4\.pluto\.tv|service-stitcher\.clusters\.pluto\.tv|stitcher\.pluto\.tv|(?:[^\/]+\.)*plutotv\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Prime Video HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*hls\.(?:pv-cdn|row\.aiv-cdn)\.net|avodhlss3ww-a\.akamaihd\.net|(?:d1v5ir2lpwr8os|d22qjgkvxw22r6|d25xi40x97liuc|d27xxe7juh1us6|dmqdd6hw24ucf)\.cloudfront\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Hulu HLS = type=http-response, pattern=^https?:\/\/(?:(?:vodmanifest|manifest-dp|livemanifest-f|live-sc)\.hulustream\.com|assets\.huluim\.com|assetshuluimcom-a\.akamaihd\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Paramount HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*(?:pplus\.paramount\.tech|paramount\.tech|cbsaavideo\.com|cbsivideo\.com)|(?:[^\/.]+-pplus|cc)\.cbs\.com|cbsi\.live\.ott\.irdeto\.com|splice(?:-media)?\.paramountplus\.com)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Paramount Playback Metadata = type=http-response, pattern=^https?:\/\/www\.paramountplus\.com\/apps-api\/v\d+(?:\.\d+)*\/(?:iphone|ipad|ios|appletv|tvos|appletvtvos)\/(?:video\/cid\/[^\/?#]+|dynamicplay\/(?:show|movie)\/[^\/?#]+|content\/playability|irdeto-control\/session-token)\.json(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/manifest.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Gateway = type=http-request, pattern=^https?:\/\/(?:(?:example\.com|gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/(?!save(?:[\/?#]|$)).*|(?:(?:[^\/]+\.)*(?:pplus\.paramount\.tech|paramount\.tech|cbsaavideo\.com|cbsivideo\.com)|(?:[^\/.]+-pplus|cc)\.cbs\.com|cbsi\.live\.ott\.irdeto\.com|splice(?:-media)?\.paramountplus\.com)\/__gss__\/(?:manifest|playlist|subtitle)(?:[\/?#].*)?)$, requires-body=0, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/gateway.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}
GSS Gateway Save = type=http-request, pattern=^https?:\/\/(?:example\.com|gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/save(?:\?.*)?$, requires-body=1, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.8.0/gateway.js, argument=presetMode=true&safePlayback=true&trackStrategy=replace-source&maxReplaceSource=true&paramountReplaceSource=true&hyMt2Preset={{{HY_MT2}}}&platformDiscovery={{{DISCOVERY}}}&discoveryHlsOnly={{{DISCOVERY_HLS_ONLY}}}&platformMax={{{MAX}}}&platformPluto={{{PLUTO}}}&platformPrime={{{PRIME}}}&platformHulu={{{HULU}}}&platformParamount={{{PARAMOUNT}}}&platformOther={{{OTHER}}}&injectTranslated={{{PURE_TRACK}}}&cacheEnabled={{{CACHE}}}&logEnabled={{{LOGS}}}&debug={{{DEBUG}}}

[Rule]
# Pluto's segment CDN is poisoned as 0.0.0.0 by some local DNS resolvers.
# Resolve it through the selected proxy so video, keys and captions stay usable.
DOMAIN-SUFFIX,plutotv.net,PROXY,force-remote-dns

[MITM]
hostname = %APPEND% *.prod.media.max.com, *.prd.media.max.com, *.prod.media.h264.io, *.prd.media.h264.io, *.hbomaxcdn.com, manifests.api.hbo.com, manifests.v2.api.hbo.com, *discovery*.uplynk.com, dplus-*.akamaized.net, dplus-*.h264.io, discovery-*.h264.io, stitcher-ipv4.pluto.tv, service-stitcher.clusters.pluto.tv, stitcher.pluto.tv, *.prd.pluto.tv, *.plutotv.net, *.hls.pv-cdn.net, *.hls.row.aiv-cdn.net, *avodhlss3ww-a.akamaihd.net, d1v5ir2lpwr8os.cloudfront.net, d22qjgkvxw22r6.cloudfront.net, d25xi40x97liuc.cloudfront.net, d27xxe7juh1us6.cloudfront.net, dmqdd6hw24ucf.cloudfront.net, vodmanifest.hulustream.com, manifest-dp.hulustream.com, livemanifest-f.hulustream.com, live-sc.hulustream.com, assets.huluim.com, assetshuluimcom-a.akamaihd.net, *.pplus.paramount.tech, *.paramount.tech, *.cbsaavideo.com, *.cbsivideo.com, *-pplus.cbs.com, cc.cbs.com, cbsi.live.ott.irdeto.com, www.paramountplus.com, splice.paramountplus.com, splice-media.paramountplus.com, *.media.dssott.com, *.prod.dssott.com, *.media.starott.com, *.prod.starott.com, *.media.dssedge.com, *.prod.dssedge.com, *.cdn.peacocktv.com, *.stream.peacocktv.com, *-vod.fubo.tv, hls.ted.com, vod-*.live.cf.md.bbci.co.uk, vod-*-live.akamaized.net, manifest-viki.viki.io, *.tubi.video, *.tubitv.com, *.crunchyroll.com, *.vrv.co, *.dazn.com, *.dazn-api.com, *.plex.direct, example.com, gss.local
