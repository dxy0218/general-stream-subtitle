#!name=General Stream Subtitle
#!desc=多平台 HLS/DASH、多字幕格式、多翻译引擎（v0.7.9）
#!author=dxy0218 & contributors
#!homepage=https://github.com/dxy0218/general-stream-subtitle
#!arguments=SOURCE=auto&TARGET=zh-CN&TRACK_NAME=Translate-zh&PROVIDER=google-free&PLATFORMS=all&DISCOVERY_MODE=full&TRACK_STRATEGY=replace-source&FORMATS=all&GENERIC=false&YT_STRATEGY=direct&YT_ASR=true&YT_LIVE=true&YT_MANUAL=true&PURE_TRACK=false&ORDER=translation-first&CACHE=true&LOGS=true&DEBUG=false

[General]
force-http-engine-hosts = %APPEND% *.hls.pv-cdn.net, *.hls.row.aiv-cdn.net, *.dash.row.aiv-cdn.net, *avodhlss3ww-a.akamaihd.net, cf-timedtext.aux.pv-cdn.net, d1v5ir2lpwr8os.cloudfront.net, d22qjgkvxw22r6.cloudfront.net, d25xi40x97liuc.cloudfront.net, d27xxe7juh1us6.cloudfront.net, dmqdd6hw24ucf.cloudfront.net

[Script]
GSS Manifest = type=http-response, pattern=^https?:\/\/(?!(?:[^\/]+\.)*(?:pluto\.tv|plutotv\.net|pplus\.paramount\.tech|paramount\.tech|paramountplus\.com|cbsaavideo\.com|cbsivideo\.com|cbs\.com|max\.com|discomax\.com|h264\.io|hbomaxcdn\.com|api\.hbo\.com|uplynk\.com|pv-cdn\.net|aiv-cdn\.net|hulustream\.com|huluim\.com)(?::\d+)?\/).+\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Max Discovery Media = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*(?:prod\.media\.max\.com|prd\.media\.max\.com|prod\.media\.h264\.io|prd\.media\.h264\.io|hbomaxcdn\.com)|manifests(?:\.v2)?\.api\.hbo\.com|[^\/.]*discovery[^\/.]*\.uplynk\.com|(?:dplus|discovery)[^\/.]*\.(?:h264\.io|akamaized\.net))\/.*\.(?:m3u8|mpd)(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Pluto HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*prd\.pluto\.tv|stitcher-ipv4\.pluto\.tv|service-stitcher\.clusters\.pluto\.tv|stitcher\.pluto\.tv|(?:[^\/]+\.)*plutotv\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Prime Video HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*hls\.(?:pv-cdn|row\.aiv-cdn)\.net|avodhlss3ww-a\.akamaihd\.net|(?:d1v5ir2lpwr8os|d22qjgkvxw22r6|d25xi40x97liuc|d27xxe7juh1us6|dmqdd6hw24ucf)\.cloudfront\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Prime Video DASH = type=http-response, pattern=^https?:\/\/(?:[^\/]+\.)*dash\.row\.aiv-cdn\.net\/.*\.mpd(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Hulu HLS = type=http-response, pattern=^https?:\/\/(?:(?:vodmanifest|manifest-dp|livemanifest-f|live-sc)\.hulustream\.com|assets\.huluim\.com|assetshuluimcom-a\.akamaihd\.net)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Paramount HLS = type=http-response, pattern=^https?:\/\/(?:(?:[^\/]+\.)*(?:pplus\.paramount\.tech|paramount\.tech|cbsaavideo\.com|cbsivideo\.com)|(?:[^\/.]+-pplus|cc)\.cbs\.com|cbsi\.live\.ott\.irdeto\.com|splice(?:-media)?\.paramountplus\.com)\/.*\.m3u8(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=20, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Paramount Playback = type=http-response, pattern=^https?:\/\/(?:[^\/]+\.)*(?:pplus\.paramount\.tech|paramount\.tech|paramountplus\.com|cbsaavideo\.com|cbsivideo\.com|cbs\.com)\/.*(?:playback|stream|live|linear|channel|station|session|manifest).*, requires-body=1, max-size=4194304, timeout=25, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/manifest.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Gateway = type=http-request, pattern=^https?:\/\/(?:example\.com|gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/(?!save(?:[\/?#]|$)).*, requires-body=0, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/gateway.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS Gateway Save = type=http-request, pattern=^https?:\/\/(?:example\.com|gss\.local|127\.0\.0\.1(?::6170)?|localhost(?::6170)?)\/save(?:\?.*)?$, requires-body=1, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/gateway.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS YouTube Player = type=http-response, pattern=^https?:\/\/(?:www\.youtube\.com|m\.youtube\.com|music\.youtube\.com|tv\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player(?:\?.*)?$, requires-body=1, max-size=4194304, timeout=30, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/youtube.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%
GSS YouTube Caption = type=http-response, pattern=^https?:\/\/(?:www\.youtube\.com|m\.youtube\.com|music\.youtube\.com|tv\.youtube\.com)\/api\/timedtext\?.*(?:gss_mode|gss_v)=.*, requires-body=1, max-size=4194304, timeout=90, script-path=https://raw.githubusercontent.com/dxy0218/general-stream-subtitle/main/dist/v0.7.9/youtube-caption.js, argument=source=%SOURCE%&target=%TARGET%&trackName=%TRACK_NAME%&provider=%PROVIDER%&platforms=%PLATFORMS%&discoveryMode=%DISCOVERY_MODE%&trackStrategy=%TRACK_STRATEGY%&formats=%FORMATS%&genericMode=%GENERIC%&youtubeStrategy=%YT_STRATEGY%&youtubeUseAsr=%YT_ASR%&youtubeLive=%YT_LIVE%&youtubePreferManual=%YT_MANUAL%&injectTranslated=%PURE_TRACK%&bilingualOrder=%ORDER%&cacheEnabled=%CACHE%&logEnabled=%LOGS%&debug=%DEBUG%

[MITM]
hostname = %APPEND% *.prod.media.max.com, *.prd.media.max.com, *.prod.media.h264.io, *.prd.media.h264.io, *.hbomaxcdn.com, manifests.api.hbo.com, manifests.v2.api.hbo.com, *.media.dssott.com, *.prod.dssott.com, *.media.starott.com, *.prod.starott.com, *.media.dssedge.com, *.prod.dssedge.com, *.hls.pv-cdn.net, *.hls.row.aiv-cdn.net, *.dash.row.aiv-cdn.net, *avodhlss3ww-a.akamaihd.net, cf-timedtext.aux.pv-cdn.net, d1v5ir2lpwr8os.cloudfront.net, d22qjgkvxw22r6.cloudfront.net, d25xi40x97liuc.cloudfront.net, d27xxe7juh1us6.cloudfront.net, dmqdd6hw24ucf.cloudfront.net, vodmanifest.hulustream.com, manifest-dp.hulustream.com, livemanifest-f.hulustream.com, live-sc.hulustream.com, assets.huluim.com, assetshuluimcom-a.akamaihd.net, *.pplus.paramount.tech, *.paramount.tech, *.paramountplus.com, *.cbsaavideo.com, *.cbsivideo.com, *.cbs.com, cbsi.live.ott.irdeto.com, *.cdn.peacocktv.com, *.stream.peacocktv.com, *discovery*.uplynk.com, dplus-*.akamaized.net, dplus-*.h264.io, discovery-*.h264.io, *.fubo.tv, hls.ted.com, vod-*.live.cf.md.bbci.co.uk, vod-*-live.akamaized.net, manifest-viki.viki.io, *.tubi.video, *.tubitv.com, stitcher-ipv4.pluto.tv, service-stitcher.clusters.pluto.tv, stitcher.pluto.tv, *.prd.pluto.tv, *.plutotv.net, *.crunchyroll.com, *.vrv.co, *.dazn.com, *.dazn-api.com, *.plex.direct, *.youtube.com, youtubei.googleapis.com, example.com, gss.local
